{
  "name": "fantasy-draft-order",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:force": "bash scripts/dev.sh --force",
    "dev:tunnel": "bash scripts/dev.sh --tunnel",
    "dev:web": "next dev --turbopack --port 3042",
    "dev:studio": "prisma studio --port 5564 --browser none",
    "build": "prisma generate && next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio --port 5564 --browser none",
    "db:validate": "prisma validate",
    "db:migrate:new": "bash scripts/d1-migration-new.sh",
    "db:migrate:local": "wrangler d1 migrations apply fantasy-draft-order-db-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply fantasy-draft-order-db-production --remote",
    "db:seed": "pnpm db:generate && prisma db seed",
    "neon:export": "node scripts/migrate-neon-to-d1.mjs",
    "neon:import:local": "wrangler d1 execute fantasy-draft-order-db-production --local --file=prisma/data/neon-export.sql",
    "neon:import:remote": "wrangler d1 execute fantasy-draft-order-db-production --remote --file=prisma/data/neon-export.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons:export": "bash scripts/export-icons.sh",
    "indexnow:submit": "node scripts/indexnow-submit.mjs"
  },
  "prisma": {
    "seed": "pnpm exec tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.9",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.59.1",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.4",
    "better-sqlite3": "^13.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.11",
    "pg": "^8.22.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "wrangler": "^4.114.0"
  }
}
