{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_BASE_URL", "NEXT_PUBLIC_COMMIT_SHA"]
    },
    "build:cf": {
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**"],
      "env": ["NEXT_PUBLIC_BASE_URL", "NEXT_PUBLIC_COMMIT_SHA"]
    },
    "dev:web": {
      "cache": false,
      "persistent": true
    },
    "dev:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
