# There is no DATABASE_URL. The database is Cloudflare D1, reached through the
# `DB` binding declared in wrangler.jsonc. Locally, `next dev` gets that binding
# from initOpenNextCloudflareForDev() (miniflare), backed by the SQLite file
# under .wrangler/state that `pnpm db:migrate:local` writes. Nothing to set.

NEXT_PUBLIC_BASE_URL="http://localhost:3042"

# Optional: override reveal pacing (defaults: 5000 / 7000 ms)
# DRAFT_FIRST_PICK_DELAY_MS="5000"
# DRAFT_PICK_INTERVAL_MS="7000"

# Optional: commit the build came from, used to link the randomizer source at
# the exact SHA from results pages. Set by the deploy workflow from github.sha;
# leave unset locally.
# NEXT_PUBLIC_COMMIT_SHA=""

# Optional: Google Search Console verification token (content of the google-site-verification meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional, server only: per-app RevenueHog key (rh_live_..., feedback:write,
# bound to this app). When set, feedback from the site's Feedback modal is also
# copied to RevenueHog. Set it in .env.prod and as the GitHub secret.
# REVENUE_HOG_API_KEY=""
