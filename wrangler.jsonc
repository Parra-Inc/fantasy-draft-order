// Cloudflare Workers config for Fantasy Football Draft Order (OpenNext).
//
// Everything this app needs is a binding. There are no secrets: the database
// is D1, so there is no DATABASE_URL to store anywhere, and the deploy
// workflow has no `wrangler secret bulk` step at all.
//
// See docs/DEPLOY.md for the one-time setup runbook.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Resource naming convention: <project>-<app>-<environment>.
  "name": "fantasy-draft-order-web-production",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-12-01",
  // node:crypto is fully supported under this flag, which is what
  // src/lib/randomizer.ts (randomInt) and the draft seed (randomBytes) need.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // fantasyfootballdraftorder.com is registered with Cloudflare Registrar, so
  // the zone is already Active and proxied. Custom domains auto-create the DNS
  // records and certificates on deploy. www is 301'd to the apex in
  // custom-worker.ts (the canonical NEXT_PUBLIC_BASE_URL has no www).
  //
  // The old origin, fantasy-draft-order.vercel.app, stays up on Vercel as a
  // permanent redirect here. Never submit that host to IndexNow again.
  "routes": [
    { "pattern": "fantasyfootballdraftorder.com", "custom_domain": true },
    { "pattern": "www.fantasyfootballdraftorder.com", "custom_domain": true }
  ],
  // Kept on as a fallback URL for debugging a deploy before DNS settles.
  "workers_dev": true,
  // Workers Logs: capture 100% of invocations (head_sampling_rate: 1) so
  // production logs/metrics are queryable without redeploying.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Required by OpenNext so its cache layer can invoke the worker's own
  // routes. The service name must equal `name` above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fantasy-draft-order-web-production"
    }
  ],
  // The database. D1 is SQLite; src/lib/prisma.ts drives it through
  // @prisma/adapter-d1. This is a project-level resource, not an app-level
  // one, so the name drops the <app> segment.
  //
  // Migrations live next to the Prisma schema and are generated by
  // `prisma migrate diff` (Prisma Migrate does not drive D1 directly) —
  // see the db:migrate:* scripts in package.json.
  //
  // The id is substituted by the deploy workflow, which looks the database up
  // by name and creates it only if missing. Committing the real id here once
  // known makes that step a no-op. Auto-provisioning by binding name alone is
  // unreliable: a deploy that dies after the database is created leaves
  // wrangler retrying create() and failing with "already exists".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantasy-draft-order-db-production",
      "database_id": "8aa0ab93-44d4-405d-bb49-4c077cf97c55",
      "migrations_dir": "prisma/migrations"
    }
  ],
  // Live viewer count on /d/[slug]: one instance per draft slug, holding an
  // in-memory set of recent heartbeats. See
  // src/lib/presence/draft-presence.ts for why presence is a Durable Object
  // and not a D1 table. OpenNext's own DO classes (DOQueueHandler,
  // DOShardedTagCache) are re-exported from custom-worker.ts but never bound,
  // which is why this is the only entry here and the only migration tag.
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFT_PRESENCE",
        "class_name": "DraftPresence"
      }
    ]
  },
  // DraftPresence holds no storage at all, so a plain `new_classes` (key-value
  // backed) namespace would be the honest declaration. Cloudflare no longer
  // allows creating those: the deploy fails with "Creating new key-value backed
  // Durable Object namespaces is no longer supported on this account"
  // [code: 10099]. So it is declared as new_sqlite_classes, which provisions a
  // SQLite backend this object never touches. Harmless, just not free.
  //
  // Do not "fix" this back to new_classes. Changing the backend of an existing
  // namespace is not a thing either, so this tag stays as it is.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DraftPresence"]
    }
  ],
  // Non-secret runtime config, committed. NEXT_PUBLIC_* is inlined at BUILD
  // time, so the deploy workflow sets the same values in its build env; these
  // entries keep them readable at runtime too. Keep both in sync.
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://fantasyfootballdraftorder.com"
  }
}
