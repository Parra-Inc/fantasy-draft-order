# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (opennext build output, miniflare local state incl. the local D1
# database, and wrangler's local secret overrides)
.open-next
.wrangler
.dev.vars

# neon -> d1 data migration output (scripts/migrate-neon-to-d1.mjs).
# Real production rows, including creator email addresses. This repo is public:
# the export is generated on demand and imported from a laptop, never committed.
/prisma/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# turbo
.turbo

# playwright
/playwright-report/
/test-results/
/tests/e2e/screenshots/

# Written by scripts/deploy.sh after a successful local deploy; the
# IndexNow diff base for the next one. Machine-local.
.last-deploy-sha
