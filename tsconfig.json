{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // .open-next and custom-worker.ts are excluded because the worker entrypoint
  // imports ./.open-next/worker.js, which only exists after a build — it can
  // never typecheck from a clean checkout. `worker/` is excluded for the
  // sibling reason: those modules import "cloudflare:workers", which resolves
  // only in the workerd build and not in the Next type graph. Wrangler
  // typechecks both at deploy.
  // `program` is the Pulumi stack: a separate npm project with its own
  // tsconfig and dependencies (installed only by the infra job in CI), so it
  // must not be part of the app's type graph either.
  "exclude": [
    "node_modules",
    ".open-next",
    "custom-worker.ts",
    "worker",
    "program"
  ]
}
