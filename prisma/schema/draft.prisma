// SQLite has no enum type, so importSource is a plain String. The allowed
// values live in src/lib/db-enums.ts and are enforced by Zod at the API
// boundary (src/app/api/drafts/route.ts).
//
// IDs are prefixed and generated by the app via newId() in src/lib/ids.ts.
// SQLite has no gen_random_uuid(), and knowing the ids before the write is
// what lets the create-draft route commit everything in one atomic D1 batch.

model Draft {
  id             String   @id
  slug           String   @unique
  leagueName     String
  creatorName    String
  creatorEmail   String?
  scheduledFor   DateTime
  importSource   String   @default("MANUAL")
  importLeagueId String?
  seed           String
  commitSha      String?
  // Where this draft's creator came from. Written once at create time from
  // ?from= / ?src= on /new (src/lib/db-enums.ts holds the allowed sources) and
  // never read at render time: these two columns exist so the sharing loops on
  // /d/[slug] can be measured instead of guessed at. referrerSlug is only set
  // when it resolves to a real draft, so it is safe to join on.
  referrerSlug   String?
  entrySource    String   @default("DIRECT")
  createdAt      DateTime @default(now())

  teams Team[]
  picks Pick[]

  @@index([scheduledFor])
  @@index([referrerSlug])
}

model Team {
  id        String  @id
  draftId   String
  name      String
  ownerName String?
  avatarUrl String?
  sourceId  String?
  position  Int

  draft Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  picks Pick[]

  @@unique([draftId, position])
  @@index([draftId])
}

model Pick {
  id         String   @id
  draftId    String
  teamId     String
  pickNumber Int
  revealedAt DateTime

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([draftId, pickNumber])
  @@unique([draftId, teamId])
  @@index([draftId, revealedAt])
}
